# =============================================================================
#  V100-UnityMCP-ComifyUI — ГЛОБАЛЬНАЯ КОНФИГУРАЦИЯ
#  Аппарат: 4 x NVIDIA V100 32GB (sm_70 / Volta)
#
#  Распределение GPU:
#    GPU 0,1  -> 1Cat-vLLM (LLM для Unity MCP), tensor-parallel = 2
#    GPU 2    -> ComfyUI (2D-графика: текстуры, UI, иллюстрации)
#    GPU 3    -> Hunyuan3D-2.1 (3D-модели с PBR-текстурами для Unity)
#
#  Пути моделей: значения LLM_MODEL_DIR / LLM_DFLASH2_MODEL / HY3D_MODEL_DIR
#  могут быть и абсолютными (напр. /mnt/storage/models/...) — скрипты понимают
#  оба варианта.
# =============================================================================

# --- Назначение GPU (индексы CUDA) ------------------------------------------
# Дефолты = режим pipeline. Режим prod (LLM TP4 на всех 4 картах, 256k) —
# через scripts/mode.sh prod: пишет оверлей mode.env, который load_config
# подгружает после этого файла (переопределяет GPU_VLLM/LLM_TP/LLM_MAX_MODEL_LEN).
GPU_VLLM="0,1"
GPU_COMFYUI="2"
GPU_3D="3"

# --- Адреса и порты ----------------------------------------------------------
# LISTEN_HOST — куда сервисам привязываться: 127.0.0.1 — только локально;
# 0.0.0.0 — если ComfyUI/3D нужны извне
LISTEN_HOST="127.0.0.1"
# HEALTH_HOST — с какого адреса скрипты проверяют готовность сервисов
HEALTH_HOST="127.0.0.1"
VLLM_PORT=8000
COMFY_PORT=8188
HY3D_PORT=8081

# --- LLM (для Unity MCP) — 1Cat-vLLM (vLLM-форк под V100/SM70) -----------------
# https://github.com/1CatAI/1Cat-vLLM — "Make Volta Fast Again":
#   собственный FlashAttention-V100 (см70), FP8 KV-кэш, оптимизации Volta.
#   Wheel из GitHub Releases — собирать из исходников НЕ нужно.
#   Wheel cp312-only и сам фиксирует torch==2.10.0 (придёт зависимостью).
# LLM: Qwen3.8-27B — флагманское 3.8-поколение (dense 27B, 64 слоя, 4 KV-головы,
# head_dim 256, нативный контекст 262k; мультимодальная обёртка — может видеть
# скриншоты сцен).
#
# Чекпоинты (активный — LLM_MODEL_DIR, параллельные каталоги):
#   Qwen3.8-27B-NVFP4-DFlash2 (24GB)   — эталонный бандл (NVFP4 + контракт DFlash2);
#                                        дефолт в «продакшен-режиме» (см. ниже)
#   QUASAR-QAT/Qwen3.8-27B-QUASAR-NVFP4 (19.2GB) — QAT NVFP4, release-gate модель 1Cat
#   Qwen/Qwen3.8-27B-FP8 (28.8GB)      — офиц. FP8
#   Qwen/Qwen3-30B-A3B-Instruct-2507-FP8 (29.1GB) — MoE, active 3.3B (макс. контекст)
#   Qwen/Qwen3-14B-Instruct-2507 (29.6GB) — dense fp16, самый «безотказный»
#
# Режимы раскладки GPU:
#   ПАЙПЛАЙН (дефолт): GPU_VLLM="0,1", LLM_TP=2, контекст ~131k — остальные карты
#   за ComfyUI/3D; либо ПРОДАКШЕН: GPU_VLLM="0,1,2,3", LLM_TP=4, LLM_MAX_MODEL_LEN=262144
#   (LLM на всех 4 картах, 256k — эталонный набор 1Cat; ComfyUI/3D тогда не запускаем).
LLM_MODEL_DIR="models/llm/Qwen3.8-27B-QUASAR-NVFP4"
LLM_SERVED_NAME="unity-llm"
LLM_TP=2                       # tensor-parallel по 2 картам (4 в «продакшен-режиме»)
LLM_MAX_MODEL_LEN=131072       # 262144 (256k) влезает только при LLM_TP=4
LLM_GPU_MEM_UTIL=0.90          # доля VRAM, которую vLLM вправе занять (анти-OOM)
LLM_MAX_NUM_SEQS=16            # параллельных стримов
LLM_MAX_BATCHED_TOKENS=8192    # окно батча (chunked prefill)
LLM_EXTRA_FLAGS=""             # дополнительные аргументы vllm serve (в одну строку)

# 1Cat-vLLM: релиз и контрольная сумма wheel
ONECAT_VLLM_VERSION="1.5.0"
ONECAT_VLLM_WHEEL_URL="https://github.com/1CatAI/1Cat-vLLM/releases/download/v1.5.0/1cat_vllm-1.5.0-cp312-cp312-linux_x86_64.whl"
ONECAT_VLLM_WHEEL_SHA256="2a4d6bee4e19d315b142f2c563059f3064ddeeca563a6bdc828c33e1073c825b"

# 1Cat-vLLM: V100-специфичные флаги
LLM_ATTENTION_BACKEND="FLASH_ATTN_V100"  # FA форка для sm70 (на V100 включается и по умолчанию)
LLM_KV_CACHE_DTYPE="fp8_e5m2"           # FP8 KV-кэш: KV вдвое меньше при том же VRAM. "auto" — отключить
LLM_ENABLE_TOOL_PARSER=1                # 1 = OpenAI tool-calling через --enable-auto-tool-choice
LLM_TOOL_CALL_PARSER="qwen3_coder"      # парсер tool-calls (Qwen3-формат)
LLM_REASONING_PARSER="qwen3"            # разбор reasoning-блоков Qwen3
# enable_thinking: эталонный набор 1Cat для Qwen3.8+DFlash2 работает с thinking ВКЛ
# (контракт валидирован так). Для чистого агентного цикла можно 0 (короче ответы).
LLM_ENABLE_THINKING=1
# Env-переменные 1Cat (sm70): NVFP4-ядра TurboMind (обязательно для NVFP4-моделей)
# и явное включение FlashAttention-V100
VLLM_SM70_NVFP4_TURBOMIND=1
VLLM_SM70_FLASH_ATTN_V100=1
VLLM_CUDA_DEVICE_ORDER="PCI_BUS_ID"     # порядок индексов GPU как в nvidia-smi
# Готовое окружение vLLM (конда/venv вне проекта): путь к python — тогда setup
# не ставит wheel, а использует ваш env. Дефолт пусто = venvs/vllm из setup'а.
VLLM_PYTHON=""                          # напр. $HOME/miniconda3/envs/1cat-vllm-15/bin/python

# DFlash2 — спекулятивное декодирование (1Cat-vLLM): официальный draft
# incoai/Qwen3.8-27B-DFlash2 (3.6GB). На 4x V100 (TP4) 1Cat меряет 206–250 tok/s;
# на нашем TP2 работает с частичным фолбэком fast-path'ов — тем не менее заметно
# быстрее обычного decode. Дефолт 0 (надёжность в приоритете); включить:
# скачать draft (models/README.md) и поставить LLM_DFLASH2=1
LLM_DFLASH2=0
LLM_DFLASH2_MODEL="models/llm/Qwen3.8-27B-DFlash2"

# --- ComfyUI (2D-генерация) ---------------------------------------------------
COMFYUI_REPO_URL="https://github.com/comfyanonymous/ComfyUI.git"
COMFYUI_RESERVE_VRAM=""        # напр. "1" — оставить 1GB VRAM свободной
# Внешний каталог моделей ComfyUI (checkpoints/clip/vae/loras рядом с этим
# путём): если задан и каталоги существуют — в vendor/ComfyUI/models делаются
# симлинки на них вместо пустых локальных. Пример (модели уже лежат на диске):
#   COMFYUI_MODELS_ROOT="/mnt/storage/models/comfyui"
COMFYUI_MODELS_ROOT=""

# --- 3D-генерация (Hunyuan3D-2.1) ----------------------------------------------
HY3D_REPO_URL="https://github.com/Tencent-Hunyuan/Hunyuan3D-2.1.git"
# Модели с HF: tencent/Hunyuan3D-2.1 — подпапки hunyuan3d-dit-v2-1 (~6.9GB,
# shape), hunyuan3d-paintpbr-v2-1 (PBR-текстуры), hunyuan3d-vae-v2-1 (~0.6GB);
# вместе ~14GB (см. models/README.md)
HY3D_MODEL_DIR="models/hunyuan3d-2.1"       # либо абсолютный, напр.
                                           # /mnt/storage/models/Hunyuan3D-2.1
HY3D_SHAPE_SUBFOLDER="hunyuan3d-dit-v2-1"   # полная точность (не turbo) — макс. качество
HY3D_ENABLE_FLASHVDM=0      # 1 = ускоренный сэмплер FlashVDM (нужна turbo-модель)
HY3D_LOW_VRAM=0             # 1 = CPU-offload — страховка от OOM (медленнее)
HY3D_ENABLE_T23D=1          # 1 = режим text-to-3D (промпты текстом)

# --- Python / PyTorch ----------------------------------------------------------
# python3.12 ОБЯЗАТЕЛЕН: wheel 1Cat-vLLM собран только под cp312.
# (Ubuntu 24.04 — из коробки; 22.04 — deadsnakes PPA или uv)
PYTHON_BIN="python3.12"
# PyTorch для ComfyUI и Hunyuan3D-2 (sm_70 в сборках cu126).
# Для vLLM-венва torch НЕ ставится вручную: wheel 1Cat-vLLM сам фиксирует torch==2.10.0
TORCH_VERSION="2.7.1"
TORCHVISION_VERSION="0.22.1"
TORCH_CUDA_TAG="cu126"        # CUDA 12.6 — последняя ветка CUDA, поддерживающая V100
