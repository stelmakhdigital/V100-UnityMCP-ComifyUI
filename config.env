# =============================================================================
#  V100-UnityMCP-ComifyUI — ГЛОБАЛЬНАЯ КОНФИГУРАЦИЯ
#  Аппарат: 4 x NVIDIA V100 32GB (sm_70 / Volta)
#
#  Распределение GPU:
#    GPU 0,1  -> 1Cat-vLLM (LLM для Unity MCP), tensor-parallel = 2
#    GPU 2    -> ComfyUI (2D-графика: текстуры, UI, иллюстрации)
#    GPU 3    -> Hunyuan3D-2 (3D-модели с текстурами для Unity)
# =============================================================================

# --- Назначение GPU (индексы CUDA) ------------------------------------------
GPU_VLLM="0,1"
GPU_COMFYUI="2"
GPU_3D="3"

# --- Адреса и порты ----------------------------------------------------------
# LISTEN_HOST — куда сервисам привязываться: 127.0.0.1 — только локально;
# 0.0.0.0 — если ComfyUI/3D нужны извне
LISTEN_HOST="127.0.0.1"
# HEALTH_HOST — с какого адреса скрипты проверяют готовность сервисов
HEALTH_HOST="127.0.0.1"
VLLM_PORT=8000
COMFY_PORT=8188
HY3D_PORT=8081

# --- LLM (для Unity MCP) — 1Cat-vLLM (vLLM-форк под V100/SM70) -----------------
# https://github.com/1CatAI/1Cat-vLLM — "Make Volta Fast Again":
#   собственный FlashAttention-V100 (см70), FP8 KV-кэш, оптимизации Volta.
#   Wheel из GitHub Releases — собирать из исходников НЕ нужно.
#   Wheel cp312-only и сам фиксирует torch==2.10.0 (придёт зависимостью).
# LLM: Qwen3-30B-A3B-Instruct-2507 (MoE, 30.5B total / 3.3B active) в офиц. FP8
#   29.1GB — те же ~14.6GB/карту при TP2, что и 14B в fp16, зато:
#   decode в 3–5 раз быстрее (активных параметров 3.3B, V100 — bandwidth-bound),
#   качество ~32B-dense класса, 4 KV-головы и нативный контекст 256k.
#   1Cat-vLLM несёт оптимизированный sm70-путь для MoE + FP8 (см. их бенчмарки).
#   Запасной вариант: Qwen3-14B-Instruct-2507 (fp16, dense — самый «безотказный»).
LLM_MODEL_DIR="models/llm/Qwen3-30B-A3B-Instruct-2507-FP8"
LLM_SERVED_NAME="unity-llm"
LLM_TP=2                       # tensor-parallel по 2 картам
LLM_MAX_MODEL_LEN=131072       # длина контекста (модель поддерживает до 262144)
LLM_GPU_MEM_UTIL=0.90          # доля VRAM, которую vLLM вправе занять (анти-OOM)
LLM_MAX_NUM_SEQS=16            # параллельных стримов
LLM_MAX_BATCHED_TOKENS=8192    # окно батча (chunked prefill)

# 1Cat-vLLM: релиз и контрольная сумма wheel
ONECAT_VLLM_VERSION="1.5.0"
ONECAT_VLLM_WHEEL_URL="https://github.com/1CatAI/1Cat-vLLM/releases/download/v1.5.0/1cat_vllm-1.5.0-cp312-cp312-linux_x86_64.whl"
ONECAT_VLLM_WHEEL_SHA256="2a4d6bee4e19d315b142f2c563059f3064ddeeca563a6bdc828c33e1073c825b"

# 1Cat-vLLM: V100-специфичные флаги
LLM_ATTENTION_BACKEND="FLASH_ATTN_V100"  # FA форка для sm70 (на V100 включается и по умолчанию)
LLM_KV_CACHE_DTYPE="fp8_e5m2"           # FP8 KV-кэш: KV вдвое меньше при том же VRAM. "auto" — отключить
LLM_ENABLE_TOOL_PARSER=1                # 1 = OpenAI tool-calling через --enable-auto-tool-choice
LLM_TOOL_CALL_PARSER="qwen3_coder"      # парсер tool-calls (Qwen3-формат)
LLM_REASONING_PARSER="qwen3"            # разбор reasoning-блоков Qwen3
# enable_thinking=false уже DEFAULT в этом движке — для MCP-агента менять не нужно

# --- ComfyUI (2D-генерация) ---------------------------------------------------
COMFYUI_REPO_URL="https://github.com/comfyanonymous/ComfyUI.git"
COMFYUI_RESERVE_VRAM=""        # напр. "1" — оставить 1GB VRAM свободной

# --- 3D-генерация (Hunyuan3D-2) -----------------------------------------------
HY3D_REPO_URL="https://github.com/Tencent-Hunyuan/Hunyuan3D-2.git"
# Скачать с HF: tencent/Hunyuan3D-2 (подпапки dit/paint/vae/delight, ~36GB,
# см. models/README.md — не нужен весь репозиторий на 70GB)
HY3D_MODEL_DIR="models/hunyuan3d-2"
HY3D_SHAPE_SUBFOLDER="hunyuan3d-dit-v2-0"   # полная точность (не turbo) — макс. качество
HY3D_ENABLE_FLASHVDM=0      # 1 = ускоренный сэмплер FlashVDM (нужна turbo-модель)
HY3D_LOW_VRAM=0             # 1 = CPU-offload — страховка от OOM (медленнее)
HY3D_ENABLE_T23D=1          # 1 = режим text-to-3D (промпты текстом)

# --- Python / PyTorch ----------------------------------------------------------
# python3.12 ОБЯЗАТЕЛЕН: wheel 1Cat-vLLM собран только под cp312.
# (Ubuntu 24.04 — из коробки; 22.04 — deadsnakes PPA или uv)
PYTHON_BIN="python3.12"
# PyTorch для ComfyUI и Hunyuan3D-2 (sm_70 в сборках cu126).
# Для vLLM-венва torch НЕ ставится вручную: wheel 1Cat-vLLM сам фиксирует torch==2.10.0
TORCH_VERSION="2.7.1"
TORCHVISION_VERSION="0.22.1"
TORCH_CUDA_TAG="cu126"        # CUDA 12.6 — последняя ветка CUDA, поддерживающая V100
